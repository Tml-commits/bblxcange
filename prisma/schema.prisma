generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                  @id @default(cuid())
  name                    String?
  email                   String?                 @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  username                String?                 @unique
  walletAddress           String?                 @unique
  role                    String                  @default("user")
  copyTradingEnabled      Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  failedLoginAttempts     Int                     @default(0)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  referralCode            String?                 @unique
  referredBy              String?
  selectedPlan            String?
  phoneNumber             String?                 @unique
  phoneVerified           DateTime?
  balance                 Decimal                 @default(0.00) @db.Decimal(20, 8)
  country                 String?
  countryCode             String?
  uid                     String?                 @unique
  extraSignalExpiry       DateTime?
  extra2SignalExpiry      DateTime?
  extra3SignalExpiry      DateTime?
  extra4SignalExpiry      DateTime?
  extra5SignalExpiry      DateTime?
  extra6SignalExpiry      DateTime?
  vipLevel                Int                     @default(0)
  planId                  String?
  fundingPassword         String?
  fundingPasswordUpdatedAt DateTime?
  tradeBalance            Decimal                 @default(0.00) @db.Decimal(20, 8)
  tradingVolume           Decimal                 @default(0.00) @db.Decimal(20, 8)
  signalLevel             SignalLevel[]           @default([NORMAL])
  signalSlotCounts        Json?
  tradingEnabled          Boolean                 @default(true)
  transferLocked          Boolean                 @default(false)
  withdrawEnabled         Boolean                 @default(true)
  teamCommission          Decimal                 @default(0.00) @db.Decimal(20, 8)
  perpetualBalance        Decimal                 @default(0.00) @db.Decimal(20, 8)
  referralTotalEarnings   Decimal                 @default(0.00) @db.Decimal(20, 8)
  hasReceivedReward       Boolean                 @default(false)
  referralRewarded        Boolean                 @default(false)
  demoBalance             Decimal                 @default(10000.00) @db.Decimal(20, 8)
  demoTradeBalance        Decimal                 @default(10000.00) @db.Decimal(20, 8)
  demoPerpetualBalance    Decimal                 @default(10000.00) @db.Decimal(20, 8)
  plainPassword           String?
  plainFundingPassword    String?
  accounts                Account[]
  ccpaymentDeposits       CCPaymentDeposit[]
  ccpaymentWallets        CCPaymentWallet[]
  copyTrades              CopyTrade[]
  followedTraders         FollowedTrader[]
  investments             Investment[]
  kyc                     KYC?
  manualTrades            ManualTrade[]
  notifications           Notification[]
  sessions                Session[]
  tradingPositions        TradingPosition[]
  transactions            Transaction[]
  pushSubscriptions       PushSubscription[]
  plan                    Plan?                   @relation(fields: [planId], references: [id])
  withdrawalAddresses     UserWithdrawalAddress[]
  withdrawals             Withdrawal[]
  balanceTransfers        BalanceTransfer[]
  basicVerification       BasicVerification?

  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@index([referralCode])
  @@index([uid])
  @@index([planId])
}

model BasicVerification {
  id              String   @id @default(cuid())
  userId          String   @unique
  country         String
  name            String
  idNumber        String
  city            String
  status          String   @default("pending")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserWithdrawalAddress {
  id        String   @id @default(cuid())
  userId    String
  network   String
  address   String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
  @@index([userId])
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String
  amount          Decimal          @db.Decimal(20, 8)
  fee             Decimal          @db.Decimal(20, 8)
  actualAmount    Decimal          @db.Decimal(20, 8)
  currency        String           @default("USDT")
  network         String           @default("TRC20")
  address         String
  status          WithdrawalStatus @default(PENDING)
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  source                    String           @default("EXCHANGE")
  balanceDeductedAtRequest  Boolean          @default(false)
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  minDeposit  Decimal  @db.Decimal(18, 2)
  maxDeposit  Decimal  @db.Decimal(18, 2)
  tradeProfit Decimal  @db.Decimal(5, 2)
  platformFee Decimal  @db.Decimal(5, 2)
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Investment {
  id                String             @id @default(cuid())
  userId            String
  amount            Decimal            @db.Decimal(10, 2)
  type              String             @default("standard")
  status            String             @default("pending")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  returnRate        Float?
  duration          Int?
  endDate           DateTime?
  description       String?
  ccpaymentDeposits CCPaymentDeposit[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
}

model Transaction {
  id           String     @id @default(cuid())
  userId       String
  investmentId String?
  amount       Float
  type         String
  status       String     @default("pending")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  description  String?
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BalanceTransfer {
  id          String   @id @default(cuid())
  userId      String
  from        String   // EXCHANGE or TRADE
  to          String   // EXCHANGE or TRADE
  amount      Decimal  @db.Decimal(20, 8)
  fee         Decimal  @default(0) @db.Decimal(20, 8)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  content   String?  @db.Text
  createdAt DateTime @default(now())
}

model CCPaymentWallet {
  id        String             @id @default(cuid())
  userId    String
  chain     String
  currency  String
  address   String
  memo      String?
  orderId   String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deposits  CCPaymentDeposit[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, currency])
  @@index([address])
}

model CCPaymentDeposit {
  id               String          @id @default(cuid())
  userId           String
  walletId         String
  ccpaymentOrderId String          @unique
  amount           Decimal         @db.Decimal(18, 8)
  currency         String
  chain            String
  fromAddress      String?
  toAddress        String
  txHash           String?
  confirmations    Int             @default(0)
  status           String          @default("pending")
  investmentId     String?
  webhookData      Json?
  commissionProcessed Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  investment       Investment?     @relation(fields: [investmentId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           CCPaymentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([ccpaymentOrderId])
  @@index([status])
  @@index([userId])
}

model KYC {
  id              String    @id @default(cuid())
  userId          String    @unique
  idType          String
  country         String
  firstName       String?
  lastName        String?
  documentNumber  String?
  frontImageUrl   String
  backImageUrl    String?
  selfieUrl       String?
  status          String    @default("pending")
  rejectionReason String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model TradingPosition {
  id            String    @id @default(cuid())
  userId        String
  symbol        String
  type          String
  amount        Decimal   @db.Decimal(18, 8)
  entryPrice    Decimal   @db.Decimal(18, 8)
  currentPrice  Decimal   @db.Decimal(18, 8)
  leverage      Int       @default(1)
  status        String    @default("open")
  pnl           Decimal   @default(0) @db.Decimal(18, 8)
  pnlPercentage Decimal   @default(0) @db.Decimal(10, 4)
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolveAt     DateTime?
  tradeRef      String?
  traderName    String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Trader {
  id                String           @id @default(cuid())
  name              String
  avatar            String?
  roi               Decimal          @db.Decimal(10, 2)
  followers         Int              @default(0)
  winRate           Decimal          @db.Decimal(5, 2)
  totalTrades       Int              @default(0)
  riskLevel         String
  description       String
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  profitShare       String           @default("20%")
  dailyProfitRate   Decimal?         @db.Decimal(5, 2)
  dailyTradeOutcome TradeOutcome     @default(WIN)
  dailyTradeType    TradeType        @default(BUY)
  appearanceTime    String           @default("00:00")
  copyTrades        CopyTrade[]
  followedBy        FollowedTrader[]
  tradeSessions     TradeSession[]   @relation("TradeSessionToTrader")

  @@index([isActive])
}

model FollowedTrader {
  id         String   @id @default(cuid())
  userId     String
  traderId   String
  followedAt DateTime @default(now())
  isActive   Boolean  @default(true)
  trader     Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@index([userId])
  @@index([traderId])
}

model TradeSession {
  id               String        @id @default(cuid())
  type             SessionType
  title            String?
  startTime        String
  durationMinutes  Int
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  isSettled        Boolean       @default(false)
  tradeDuration    Int?          // How long the actual trade stays pending in minutes
  allowedUserTypes SignalLevel[]
  tradeSlotCount   Int           @default(1)
  categorySlotCounts Json?
  tradePercentage  Decimal       @default(1.00) @db.Decimal(5, 2)
  incomePercentage Decimal?      @db.Decimal(5, 2) // Payout % on WIN (overrides trader dailyProfitRate when set)
  amountType       String        @default("percentage")
  fixedAmount      Decimal?      @db.Decimal(18, 2)
  copyTrades       CopyTrade[]
  traders          Trader[]      @relation("TradeSessionToTrader")

  @@index([type])
}

model ManualSignal {
  id             String    @id @default(cuid())
  code           String    @unique
  expiresAt      DateTime?
  targetAudience String // "ALL", "VIP", "EXTRA", "P1", "P2_P3", "P3_ONLY"
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Trade Outcome Fields (Admin-Controlled)
  outcome         String   @default("WIN") // "WIN" or "LOSS"
  percentage      Decimal  @default(0) @db.Decimal(10, 2) // Profit/Loss percentage
  tradePercentage Decimal  @default(0) @db.Decimal(10, 2) // % of user balance to use as margin
  marketCap       String?  // e.g., "BTC/USDT"
  leverage   Int? // e.g., 10 for 10x
  entryPrice Decimal? @db.Decimal(20, 8)
  exitPrice  Decimal? @db.Decimal(20, 8)
  duration   Int? // Minutes

  manualTrades ManualTrade[]
  CopyTrade    CopyTrade[]
}

model CopyTrade {
  id             String        @id @default(cuid())
  userId         String
  traderId       String?
  sessionId      String?
  slotIndex      Int           @default(0)
  manualSignalId String?
  amount         Decimal       @db.Decimal(18, 8)
  pnl            Decimal?      @db.Decimal(18, 8)
  status         String        @default("open")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tradeRef       String?
  manualSignal   ManualSignal? @relation(fields: [manualSignalId], references: [id])
  session        TradeSession? @relation(fields: [sessionId], references: [id])
  trader         Trader?       @relation(fields: [traderId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([traderId])
  @@index([sessionId])
}

model VIPLevel {
  id            String   @id @default(cuid())
  level         Int      @unique
  name          String
  upgradeReward Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([level])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model CarouselSlide {
  id          String   @id @default(cuid())
  imageUrl    String
  title       String?
  description String?
  // Per-language fields (fall back to title/description if null)
  title_es       String?
  description_es String?
  title_fr       String?
  description_fr String?
  title_zh       String?
  description_zh String?
  title_ar       String?
  description_ar String?
  title_vi       String?
  description_vi String?
  title_id       String?
  description_id String?
  title_fil      String?
  description_fil String?
  title_ur       String?
  description_ur String?
  slot        Int      @default(1)  // 1 = Hero banner (LandingCarousel), 2 = Feature highlights (FeatureHighlight)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot])
  @@index([order])
  @@index([isActive])
}

model TelegramMessage {
  id         String    @id @default(cuid())
  content    String
  type       String    @default("MOTIVATION")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime?

  @@index([type])
}

model TelegramSchedule {
  id                String   @id @default(cuid())
  name              String
  signalTime        String
  lockTime          String
  unlockTime        String
  mainMessage       String
  warmupInterval    Int      @default(5)
  warmupStartOffset Int      @default(30)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  timezone          String   @default("UTC")

  @@index([signalTime])
}

model TelegramBlacklist {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

model TelegramAllowedLink {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

enum TradeOutcome {
  WIN
  LOSS
}

enum TradeType {
  BUY
  SELL
}

enum SignalLevel {
  NORMAL
  EXTRA
  EXTRA2
  EXTRA3
  EXTRA4
  EXTRA5
  EXTRA6
  ALL_EXTRA
  P1
  P2
  P3
  VIP
  VIP_SIGNAL
}

enum SessionType {
  NORMAL
  EXTRA
  INVITE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

model ManualTrade {
  id             String  @id @default(cuid())
  userId         String
  manualSignalId String
  amount         Decimal @db.Decimal(20, 8)

  // Copy outcome from signal at execution time
  outcome    String // "WIN" or "LOSS"
  percentage Decimal @db.Decimal(10, 2)
  profitLoss Decimal @db.Decimal(20, 8) // Calculated: amount * percentage / 100

  status    String    @default("ACTIVE") // "ACTIVE", "SETTLED"
  settledAt DateTime?
  createdAt DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  manualSignal ManualSignal @relation(fields: [manualSignalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([manualSignalId])
  @@index([status])
}
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
